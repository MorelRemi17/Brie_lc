---
import { Image } from 'astro:assets';
import { photo, largeurs } from '../lib/site';
import club from '../data/club.json';

const hero = photo('hero.png');
// « Salle des fêtes de Brie » → « salle des fêtes de Brie » (seule l'initiale passe en minuscule)
const lieu = club.lieuRdv.charAt(0).toLowerCase() + club.lieuRdv.slice(1);
---
<section class="hero" id="accueil">
  {hero && (
    <Image
      src={hero}
      alt="Cyclistes du club Brie L.C. en maillot vert et noir, en sortie sur une petite route de campagne"
      class="hero__fond"
      widths={largeurs(hero, [640, 1024, 1600, 2400])}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
  )}
  <div class="wrap hero__contenu">
    <div class="hero__col">
      <h1 class="hero__h1">
        <span class="hero__kicker">Club cyclo de Brie</span>
        <span class="hero__titre">Roulez avec<br />Brie L.C.</span>
      </h1>
      <p class="hero__texte">
        Sortie route tous les dimanches matin au départ de la {lieu}. Tous niveaux, dans la bonne humeur.
      </p>
      <div class="hero__ctas">
        <a href="/#rejoindre" class="btn">Viens essayer un dimanche</a>
        <a href="/#actus" class="btn-ligne btn-ligne--blanc">Voir les actus</a>
      </div>
    </div>
  </div>
</section>
<div class="bandeau" aria-hidden="true"></div>
