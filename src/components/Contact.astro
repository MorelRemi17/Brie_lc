---
import club from '../data/club.json';
import { lien, externe, mailHref, telHref } from '../lib/site';

const reseaux = [
  { nom: 'Facebook', href: lien(club.facebook) },
  { nom: 'Instagram', href: lien(club.instagram) },
];
const mail = mailHref(club.email);
// Carte OpenStreetMap centrée sur le lieu de rendez-vous (coordonnées : Base Adresse Nationale)
const { latitude: lat, longitude: lon } = club;
const bbox = [lon - 0.012, lat - 0.006, lon + 0.012, lat + 0.006].map((n) => n.toFixed(6)).join('%2C');
const carte = `https://www.openstreetmap.org/export/embed.html?bbox=${bbox}&layer=mapnik&marker=${lat}%2C${lon}`;
const carteGrande = `https://www.openstreetmap.org/?mlat=${lat}&mlon=${lon}#map=17/${lat}/${lon}`;
const tel = telHref(club.telephonePresident);
---
<section class="wrap contact" id="contact">
  <div class="contact__texte">
    <h2 class="titre-section">Contact</h2>
    <p class="contact__adresse">
      {club.lieuRdv}<br />{club.adresse}, {club.codePostal} {club.ville}<br />Rendez-vous le dimanche à {club.horaireEte} en été, {club.horaireHiver} en hiver
    </p>
    <div class="contact__coord">
      {mail ? <a href={mail}>{club.email}</a> : <span>{club.email}</span>}
      {tel ? <a href={tel}>{club.telephonePresident}</a> : <span>{club.telephonePresident}</span>}
    </div>
    <div class="reseaux">
      {reseaux.map((r) => <a href={r.href ?? '#'} {...externe(r.href)}>{r.nom}</a>)}
    </div>
  </div>
  <div class="contact__carte">
    <iframe
      class="carte-osm"
      title={`Carte : ${club.lieuRdv}, ${club.adresse}, ${club.ville}`}
      loading="lazy"
      src={carte}
    ></iframe>
    <a href={carteGrande} class="contact__carte-lien" target="_blank" rel="noopener">Agrandir la carte →</a>
  </div>
</section>
