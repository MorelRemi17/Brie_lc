---
import CarteActu from './CarteActu.astro';
import { filActus } from '../lib/site';

// Événements à venir en tête, puis les actus et événements passés les plus récents.
const MAX = 6;
const liste = await filActus(MAX);
---
{liste.length > 0 && (
  <section class="section--alt" id="actus">
    <div class="wrap section section--actus">
      <div class="section__entete">
        <h2 class="titre-section">Les actus</h2>
        <a href="/evenements/" class="lien-fleche">Toutes les actus →</a>
      </div>
      <div class="grille-actus">
        {liste.map((c) => <CarteActu carte={c} />)}
      </div>
    </div>
  </section>
)}
