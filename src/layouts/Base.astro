---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';

// Polices hébergées sur le site (Fontsource) : aucune requête vers Google.
import '@fontsource/permanent-marker/400.css';
import '@fontsource/kaushan-script/400.css';
import '@fontsource/barlow/400.css';
import '@fontsource/barlow/500.css';
import '@fontsource/barlow/600.css';
import '@fontsource/barlow/700.css';
import '@fontsource/barlow-condensed/800.css';
import '../styles/global.css';

import { photo } from '../lib/site';

interface Props {
  title: string;
  description: string;
  /** Image de partage (réseaux sociaux) ; par défaut la photo du hero */
  image?: ImageMetadata;
  ogType?: 'website' | 'article';
}
const { title, description, image, ogType = 'website' } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const logo = photo('logo.png');
const favicon = logo ? await getImage({ src: logo, width: 64, height: 64, format: 'png' }) : undefined;
const partage = image ?? photo('hero.png');
const og = partage ? await getImage({ src: partage, width: 1200, format: 'jpg' }) : undefined;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#3fae3a" />
    {favicon && <link rel="icon" type="image/png" href={favicon.src} />}
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="Cyclo VTT Brie L.C." />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {og && <meta property="og:image" content={new URL(og.src, Astro.site)} />}
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
