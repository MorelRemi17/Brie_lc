---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';

// Polices hébergées sur le site (Fontsource) : aucune requête vers Google.
import '@fontsource/permanent-marker/400.css';
import '@fontsource/kaushan-script/400.css';
import '@fontsource/barlow/400.css';
import '@fontsource/barlow/500.css';
import '@fontsource/barlow/600.css';
import '@fontsource/barlow/700.css';
import '@fontsource/barlow-condensed/800.css';
import '../styles/global.css';
// Préchargées : les 3 polices visibles dès l'arrivée sur la page (titre, accroche, texte du hero).
// Évite le « saut » de mise en page au chargement des polices (CLS) et accélère l'affichage (LCP).
import fontMarker from '@fontsource/permanent-marker/files/permanent-marker-latin-400-normal.woff2?url';
import fontScript from '@fontsource/kaushan-script/files/kaushan-script-latin-400-normal.woff2?url';
import fontTexte from '@fontsource/barlow/files/barlow-latin-500-normal.woff2?url';

import { photo } from '../lib/site';

interface Props {
  title: string;
  description: string;
  /** Image de partage (réseaux sociaux) ; par défaut la photo du hero */
  image?: ImageMetadata;
  imageAlt?: string;
  ogType?: 'website' | 'article';
  /** true : page exclue des moteurs de recherche (contenu pas encore rempli, 404…) */
  noindex?: boolean;
}
const { title, description, image, imageAlt, ogType = 'website', noindex = false } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const logo = photo('logo.png');
const favicon = logo ? await getImage({ src: logo, width: 64, height: 64, format: 'png' }) : undefined;
const appleIcon = logo ? await getImage({ src: logo, width: 180, height: 180, format: 'png', background: '#ffffff', fit: 'contain' }) : undefined;
const partage = image ?? photo('hero.png');
const og = partage ? await getImage({ src: partage, width: Math.min(1200, partage.width), format: 'jpg' }) : undefined;
const ogAlt = imageAlt ?? (image ? title : 'Cyclistes du club Cyclo VTT Brie L.C. en sortie sur route');
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#3fae3a" />
    <!-- Validation Google Search Console (propriété https://brielc.netlify.app/) : ne pas supprimer -->
    <meta name="google-site-verification" content="TFl3WQwz8zhK1FRlp2GCixQnjRVKmdx82cfGqlTxYL4" />
    <link rel="preload" href={fontMarker} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={fontScript} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={fontTexte} as="font" type="font/woff2" crossorigin />
    {favicon && <link rel="icon" type="image/png" sizes="64x64" href={favicon.src} />}
    {appleIcon && <link rel="apple-touch-icon" href={appleIcon.src} />}

    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="Cyclo VTT Brie L.C." />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {og && (
      <>
        <meta property="og:image" content={new URL(og.src, Astro.site)} />
        <meta property="og:image:width" content={String(og.attributes.width)} />
        <meta property="og:image:height" content={String(og.attributes.height)} />
        <meta property="og:image:alt" content={ogAlt} />
      </>
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {og && <meta name="twitter:image" content={new URL(og.src, Astro.site)} />}
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
