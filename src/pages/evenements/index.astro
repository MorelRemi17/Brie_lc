---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CarteActu from '../../components/CarteActu.astro';
import club from '../../data/club.json';
import { filActus } from '../../lib/site';

// Archive : toutes les actus et tous les événements, à venir puis du plus récent au plus ancien.
// Garde un lien vers chaque page d'événement même quand il a disparu de l'accueil
// (sinon page « orpheline » pour Google).
const tout = await filActus();
const blocs = [
  { titre: 'À venir', liste: tout.filter((c) => c.aVenir) },
  { titre: 'Les dernières actus', liste: tout.filter((c) => !c.aVenir) },
];
---
<Base
  title={`Actus et événements – ${club.nom}`}
  description={`Les actus du club ${club.nom} à ${club.ville} (${club.departement}) : événements à venir, résultats, sorties et randonnées.`}
>
  <Header />
  <main class="wrap section archive">
    <nav class="fil-ariane" aria-label="Fil d'Ariane">
      <ol>
        <li><a href="/">Accueil</a></li>
        <li aria-current="page">Actus et événements</li>
      </ol>
    </nav>
    <div class="titre-bloc">
      <div class="titre-bloc__kicker">La vie du club</div>
      <h1 class="titre-section">Actus et événements</h1>
    </div>

    {blocs.map((bloc) =>
      bloc.liste.length > 0 && (
        <section class="archive__bloc">
          <h2 class="archive__titre">{bloc.titre}</h2>
          <div class="grille-actus">
            {bloc.liste.map((c) => <CarteActu carte={c} />)}
          </div>
        </section>
      )
    )}
  </main>
  <Footer />
</Base>
